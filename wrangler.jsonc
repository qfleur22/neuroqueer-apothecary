{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "neuroqueer-apothecary",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "neuroqueer-apothecary"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SHOPIFY_DOMAIN": "mntpms-es.myshopify.com",
    "NEXT_PUBLIC_SHOPIFY_HYPERMOBILE_VARIANT_ID": "49249179828394",
    "NEXT_PUBLIC_SHOPIFY_TRANSITION_VARIANT_ID": "49249189724330",
    "NEXT_PUBLIC_SHOPIFY_ANIME_GUIDE_VARIANT_ID": "49249191788714",
    "NEXT_PUBLIC_SHOPIFY_ANIME_KIT_VARIANT_ID": "49249198899370",
    "NEXT_PUBLIC_SHOPIFY_CUSTOM_BINDER_VARIANT_ID": "49319943995562",
    "NEXT_PUBLIC_SHOPIFY_CARE_PLAN_VARIANT_ID": "49319944061098",
    "NEXT_PUBLIC_SHOPIFY_CARE_PLAN_WORKSHOP_VARIANT_ID": "49319944126634",
    "NEXT_PUBLIC_SHOPIFY_CONSENT_VARIANT_ID": "49319944159402",
    "NEXT_PUBLIC_SHOPIFY_CONSENT_WORKSHOP_VARIANT_ID": "49320039547050"
  }
}
