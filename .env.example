# Public checkout (baked in at build time for store links)
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_HYPERMOBILE_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_TRANSITION_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_ANIME_GUIDE_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_ANIME_KIT_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_BINDER_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_CUSTOM_BINDER_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_CARE_PLAN_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_CARE_PLAN_WORKSHOP_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_CONSENT_VARIANT_ID=
NEXT_PUBLIC_SHOPIFY_CONSENT_WORKSHOP_VARIANT_ID=
NEXT_PUBLIC_TIDYCAL_PATH=

# Customer Account API (Headless channel or custom app). Callback:
# https://your-domain/api/auth/shopify/callback
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_SESSION_SECRET=change-this-to-a-long-random-string

# Used only by `npm run setup:shopify`. Keep these out of NEXT_PUBLIC_*.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_ACCESS_TOKEN=
